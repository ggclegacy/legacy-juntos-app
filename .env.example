NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
# Set to a text model available to your provider account.
OPENAI_MODEL=

# Explicit opt-in after reviewing health-data handling; optional appointment review.
HEALTH_AI_ENABLED=false

# Nutrition: USDA search and explicit opt-in to AI processing
USDA_API_KEY=
NUTRITION_AI_ENABLED=false

# Creative Studio: apply the Studio migration and configure private studio-media bucket.
# Image generation uses OPENAI_API_KEY; text uses OPENAI_MODEL above.
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=
# A voice you have permission to use. Enroll/verify personal clones with the provider.
ELEVENLABS_VOICE_ID=
# Server-only worker credential, NEVER NEXT_PUBLIC. Enable only after scheduling worker calls.
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_WORKER_SECRET=
STUDIO_WORKER_ENABLED=false
